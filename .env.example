# Copy this file to .env on the server.
# Never commit real secrets.

APP_ENV=production
APP_URL=https://your-domain.example

DB_HOST=localhost
DB_USER=travel_user
DB_PASS=change_this_strong_password
DB_NAME=travel_itinerary_db

GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.15
GEMINI_TIMEOUT=4

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Admin Smart Travel Itinerary Generator

# Local AI (Ollama). Every AI feature goes through services/OllamaClient.php.
# qwen2.5:3b with a 4096-token context fits in a 4 GB GPU (about 2.2 GB).
# Keep OLLAMA_BASE_URL on 127.0.0.1: never expose port 11434 to the internet.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=60
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_KEEP_ALIVE=30m
