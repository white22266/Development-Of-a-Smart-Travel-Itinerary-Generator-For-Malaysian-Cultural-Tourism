# Copy this file to .env on the server.
# Never commit real secrets.

APP_ENV=production
APP_URL=https://your-domain.example

DB_HOST=localhost
DB_USER=travel_user
DB_PASS=change_this_strong_password
DB_NAME=travel_itinerary_db

GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.15
GEMINI_TIMEOUT=4

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Admin Smart Travel Itinerary Generator

# AI assistant speed settings for VM deployment.
# Gemini is disabled by default because the VM should use local Ollama directly.
AI_USE_GEMINI=false
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=512
OLLAMA_TIMEOUT=10
OLLAMA_CONNECT_TIMEOUT=2
OLLAMA_NUM_PREDICT=100
OLLAMA_NUM_THREAD=4
OLLAMA_TEMPERATURE=0.15
OLLAMA_KEEP_ALIVE=30m
