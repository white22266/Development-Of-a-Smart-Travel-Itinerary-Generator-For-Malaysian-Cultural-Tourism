# Copy this file to .env on the server.
# Never commit real secrets.

APP_ENV=production
APP_URL=https://your-domain.example

DB_HOST=localhost
DB_USER=travel_user
DB_PASS=change_this_strong_password
DB_NAME=travel_itinerary_db

GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Admin Smart Travel Itinerary Generator

# AI assistant. Gemini is tried first when GEMINI_API_KEY is set; Ollama is the fallback.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=512
