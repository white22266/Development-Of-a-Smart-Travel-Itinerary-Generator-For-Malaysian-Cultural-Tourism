# Copy this file to .env on the server.
# Never commit real secrets.

APP_ENV=production
APP_URL=https://your-domain.example

DB_HOST=localhost
DB_USER=travel_user
DB_PASS=change_this_strong_password
DB_NAME=travel_itinerary_db

GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
SERPAPI_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Admin Smart Travel Itinerary Generator

# Local AI assistant. On a small free VM, keep Ollama disabled unless you installed and tested it.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
