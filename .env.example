# Copy this file to .env on the server.
# Never commit real secrets.

APP_ENV=production
APP_URL=https://your-domain.example
# Dates and times are shown in this time zone, whatever the server itself is set to.
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=localhost
DB_USER=travel_user
DB_PASS=change_this_strong_password
DB_NAME=travel_itinerary_db

# Mail (password reset and account e-mails).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Admin Smart Travel Itinerary Generator

# Local AI (Ollama). Every AI feature goes through services/OllamaClient.php.
# qwen2.5:3b with a 4096-token context fits in a 4 GB GPU (about 2.2 GB).
# Keep OLLAMA_BASE_URL on 127.0.0.1: never expose port 11434 to the internet.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=60
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_KEEP_ALIVE=30m

# Open data. Maps, place data, search, routing and weather come from free services that need
# no API key: OpenStreetMap (map tiles, Overpass, Nominatim, Photon), Wikidata, Wikipedia,
# Wikimedia Commons, OSRM, Valhalla, Open-Meteo, data.gov.my and NASA FIRMS. They are free
# because they are used lightly:
# services/OpenDataHttp.php caches every answer and spaces requests out.
#
# These services ask every application to say who runs it, so they can get in touch instead
# of blocking it. Put a web address or an e-mail address here; it is sent with each request.
OPEN_DATA_CONTACT=

# Places found by tools/sync_places.php with at least this score (0-100) are published without
# review; the rest wait on the admin page "Open Data Imports". Use 101 to review everything.
PLACE_SYNC_AUTO_PUBLISH_MIN=80

# Routing servers. Leave empty to use the public servers of the German OpenStreetMap
# community. Set these if you run your own: OSRM for car and walking, Valhalla for motorcycles.
ROUTING_CAR_URL=
ROUTING_FOOT_URL=
ROUTING_VALHALLA_URL=

# Optional. Set to 1 to ask no routing or weather server at all: every distance and time is then
# an estimate from the straight line (offline runs and tools/check_planner.php).
# ROUTING_ESTIMATES_ONLY=1

# Optional: real public transport connections from published timetables, through a MOTIS
# server. The public one is https://api.transitous.org. Read https://transitous.org/api/
# first: it is for open-source, non-commercial projects that use it lightly.
# Empty = public transport times are estimates.
TRANSIT_API_URL=

# Optional: live traffic on the route (jams, closed and flooded roads) from TomTom.
# This is NOT open data: TomTom is a commercial service with a free allowance (2,500 incident
# requests a month at the time of writing, no credit card; requests beyond it are refused,
# not charged). Get a key at https://developer.tomtom.com. Empty = no live traffic.
TOMTOM_API_KEY=
# The application stops asking TomTom after this many requests in a calendar month.
TOMTOM_MONTHLY_LIMIT=2400
